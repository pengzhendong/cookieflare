{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "frontend/**/*",
    "vite.config.ts",
    "auto-imports.d.ts",
    "components.d.ts"
  ],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "checkUnknownProps": false
  }
}
