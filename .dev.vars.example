# Optional. If set, add this exact header to CookieCloud uploads:
# X-CookieCloud-Token: <the same value>
COOKIECLOUD_UPDATE_TOKEN=""

# Password for the /admin page. For production, prefer:
# npx wrangler secret put ADMIN_PASSWORD --config wrangler.production.jsonc
ADMIN_PASSWORD="replace-with-a-long-random-password"

# Optional administrator username. Defaults to admin when omitted.
ADMIN_USERNAME="admin"

# Optional Analytics credentials for the authenticated runtime page.
# For production, configure the token as a Wrangler Secret.
# CLOUDFLARE_ANALYTICS_ACCOUNT_ID=""
# CLOUDFLARE_ANALYTICS_TOKEN=""
# CLOUDFLARE_ANALYTICS_WORKER_NAME="cookieflare"
