# This must be the same UUID configured in the CookieCloud client.
COOKIECLOUD_UUID="replace-with-a-long-random-uuid"

# Optional. If set, add this exact header to CookieCloud uploads:
# X-CookieCloud-Token: <the same value>
COOKIECLOUD_UPDATE_TOKEN=""

# Required for the /admin page. Use the Cloudflare Access team domain and
# the Application Audience (AUD) tag of the Access application protecting it.
ADMIN_ACCESS_TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
ADMIN_ACCESS_AUD="replace-with-your-access-application-aud"

# Optional defense-in-depth allowlist. Use a comma-separated list of emails.
ADMIN_ACCESS_ALLOWED_EMAILS=""
