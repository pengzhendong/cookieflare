{
  "name": "cookieflare",
  "private": true,
  "version": "0.1.0",
  "description": "CookieCloud-compatible API on Cloudflare Workers and KV",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:console && wrangler dev --local",
    "deploy": "wrangler deploy --keep-vars",
    "types": "wrangler types",
    "check": "npm run build:console && tsc --noEmit && tsc -p tsconfig.web.json && npm run doctor && wrangler deploy --dry-run",
    "test": "vitest run",
    "verify": "npm run types && npm run check && npm test",
    "build:console": "node scripts/build-console.mjs",
    "doctor": "node vendor/worker-kit/src/tooling/doctor.mjs --project ."
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@pengzhendong/worker-kit": "file:vendor/worker-kit",
    "@scalar/api-reference-react": "0.9.82",
    "antd": "6.6.7",
    "openapi-types": "12.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "semver": "7.8.5"
  }
}
