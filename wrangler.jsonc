{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cookieflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "API_ROOT": ""
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2026080201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "COOKIE_STORE",
      "id": "00000000000000000000000000000000"
    }
  ]
}
