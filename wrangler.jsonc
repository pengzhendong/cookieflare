{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cookieflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "API_ROOT": ""
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2026080201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "2026080202",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "2026102501",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "COOKIE_STORE",
      "id": "8835bf7c41bf4f039dfd793b944cf5ab"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build:console"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
